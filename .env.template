# Environment Configuration Template
# Constitution Compliance: AEGIS (Clause 2.1) - Security through environment variables

# ============================================================================
# SECURITY CONFIGURATION (AEGIS)
# ============================================================================

# Data Source Configuration
# Path to the GDP data file (relative to project root)
GDP_DATA_PATH=data/gdp_data.csv

# Cache Configuration  
# Time-to-live for data cache in seconds (3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Data Range Configuration
# Minimum year for GDP data (inclusive)
MIN_YEAR=1960

# Maximum year for GDP data (inclusive)  
MAX_YEAR=2022

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Performance Monitoring
# Enable detailed performance logging (true/false)
ENABLE_PERFORMANCE_LOGGING=false

# ============================================================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================================================

# Streamlit server configuration (uncomment if needed)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_SERVER_HEADLESS=false

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 
# Constitution Article 2, Clause 2.1 (AEGIS):
# - Never commit this file with actual secrets to version control
# - Use strong, unique values for any authentication tokens
# - Rotate secrets regularly in production environments
# - Consider using a secrets management service for production
#
# This template demonstrates proper security practices:
# ✅ Environment variable configuration
# ✅ No hardcoded secrets
# ✅ Clear documentation
# ✅ Safe defaults